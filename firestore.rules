rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    //  권한 판정은 전부 이 파일(서버측)에서 한다.
    //  클라이언트가 보내는 값(sessionStorage, 화면 상태, JS 변수)은 신뢰하지 않는다.
    //
    //  신원은 Google(HUFS Workspace)이 서명한 ID 토큰에서만 나온다.
    //  토큰의 email 클레임은 위조할 수 없으므로, 도메인 검사가 곧 재학생 확인이다.
    // ============================================================

    // HUFS 구성원 = Google 로그인 + 검증된 @hufs.ac.kr 메일
    // 클라이언트의 hd 파라미터는 UI 힌트일 뿐이라 우회가 가능하다.
    // 실제 차단은 여기서 한다.
    function isHufs() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        // 허용 도메인을 늘리려면 아래 괄호 안에 | 로 추가한다.
        //   예: '.*@(hufs[.]ac[.]kr|gsis[.]hufs[.]ac[.]kr)'
        // ⚠️ js/hufs.js 의 HUFS_DOMAINS 도 같이 고쳐야 화면 안내가 맞는다.
        && request.auth.token.email.lower().matches('.*@(hufs[.]ac[.]kr)');
    }

    // 관리자 = HUFS 구성원 + admins/{uid} 문서 존재.
    // admins 문서는 클라이언트가 만들 수 없으므로(아래 write: false)
    // Firebase Console 에서 등록한 계정만 관리자가 된다.
    function isAdmin() {
      return isHufs()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 상담 스레드 문서 ID 가 곧 본인 uid 이므로,
    // 다른 사람의 스레드는 경로 단계에서 접근이 차단된다.
    function isOwner(threadId) {
      return isHufs() && request.auth.uid == threadId;
    }

    // ── 관리자 명부 ─────────────────────────────────
    // 본인 문서만 읽을 수 있다(로그인 후 관리자 여부 확인용).
    // 목록 조회(list)와 모든 쓰기는 금지 — 등록/해지는 Console 에서만.
    match /admins/{uid} {
      allow get:   if request.auth != null && request.auth.uid == uid;
      allow list:  if false;
      allow write: if false;
    }

    // ── 상담 스레드 ─────────────────────────────────
    match /chat_threads/{threadId} {
      // 단건 조회: 본인 스레드 또는 관리자.
      allow get: if isOwner(threadId) || isAdmin();

      // 컬렉션 전체 조회(관리자 대시보드의 목록)는 관리자만.
      // list 는 문서 ID 와 무관하게 평가되므로 isOwner 를 쓰지 않는다.
      allow list: if isAdmin();

      // 스레드에 기록되는 email 은 반드시 토큰의 email 과 같아야 한다.
      // (다른 사람 이름표를 달고 질문하는 것을 막는다)
      allow create: if isOwner(threadId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;

      // 소유자 uid 와 email 은 생성 이후 바뀔 수 없다(스레드 탈취 방지).
      allow update: if (isOwner(threadId) || isAdmin())
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email;

      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if isOwner(threadId) || isAdmin();

        // 학생은 본인 스레드에 role:"student" 메시지만 쓸 수 있다.
        allow create: if isOwner(threadId)
          && request.resource.data.role == 'student'
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;

        // role:"admin" 답변은 관리자만 쓸 수 있다(관리자 사칭 방지).
        allow create: if isAdmin()
          && request.resource.data.role == 'admin'
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;

        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ── 운영 설정(마지막 전체 삭제 시각) ──────────────
    match /settings/{docId} {
      allow read, write: if isAdmin();
    }

    // 그 외 전부 거부
    match /{doc=**} {
      allow read, write: if false;
    }
  }
}
