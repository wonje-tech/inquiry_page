rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    //  권한 판정은 전부 이 파일(서버측)에서 한다.
    //  클라이언트가 보내는 값(sessionStorage, isAdmin 등)은 신뢰하지 않는다.
    // ============================================================

    // 이메일/비밀번호 계정으로 로그인한 사용자.
    // 익명 로그인(anonymous)은 여기서 항상 false 가 된다.
    function isPasswordUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    // 관리자 = 비밀번호 계정 + admins/{uid} 문서 존재.
    // admins 문서는 클라이언트에서 만들 수 없으므로(아래 write:false)
    // Firebase Console 에서 등록한 계정만 관리자가 된다.
    function isAdmin() {
      return isPasswordUser()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 학생 = 익명 로그인 사용자. 스레드 문서 ID 가 곧 본인 uid 이므로
    // 다른 학생의 스레드 경로에는 규칙 단계에서 접근이 차단된다.
    function isOwner(threadId) {
      return request.auth != null && request.auth.uid == threadId;
    }

    // ── 관리자 명부 ─────────────────────────────────
    // 본인 문서만 읽을 수 있다(로그인 후 관리자 여부 확인용).
    // 목록 조회(list)와 모든 쓰기는 금지 — 등록/해제는 Console 에서만.
    match /admins/{uid} {
      allow get:   if request.auth != null && request.auth.uid == uid;
      allow list:  if false;
      allow write: if false;
    }

    // ── 상담 스레드 ─────────────────────────────────
    match /chat_threads/{threadId} {
      // 단건 조회: 본인 스레드 또는 관리자.
      allow get: if isOwner(threadId) || isAdmin();

      // 컬렉션 전체 조회(관리자 대시보드의 학생 목록)는 관리자만.
      // list 는 문서 ID 와 무관하게 평가되므로 isOwner 를 쓰지 않는다.
      allow list: if isAdmin();

      allow create: if isOwner(threadId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.studentId is string
        && request.resource.data.studentId.size() > 0
        && request.resource.data.studentId.size() <= 12
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && request.resource.data.studentName.size() <= 10;

      // 소유자 uid 와 학번은 생성 이후 바뀔 수 없다(스레드 탈취 방지).
      allow update: if (isOwner(threadId) || isAdmin())
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.studentId == resource.data.studentId;

      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if isOwner(threadId) || isAdmin();

        // 학생은 본인 스레드에 role:"student" 메시지만 쓸 수 있다.
        allow create: if isOwner(threadId)
          && request.resource.data.role == 'student'
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;

        // role:"admin" 답변은 관리자만 쓸 수 있다(관리자 사칭 방지).
        allow create: if isAdmin()
          && request.resource.data.role == 'admin'
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;

        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ── 운영 설정(마지막 전체 삭제 시각) ──────────────
    match /settings/{docId} {
      allow read, write: if isAdmin();
    }

    // 그 외 전부 거부
    match /{doc=**} {
      allow read, write: if false;
    }
  }
}
